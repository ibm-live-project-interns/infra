# =============================================================================
# Sentrix — infra/prod/.env
# Copy this file to .env and fill in the required values before running
# docker compose. Never commit the filled .env to version control.
# =============================================================================

# =============================================================================
# REQUIRED — the platform will not start correctly without these
# =============================================================================

# A random string, minimum 32 characters. Generate with:
#   openssl rand -hex 32
JWT_SECRET=change-this-to-a-secure-random-string-minimum-32-characters

# PostgreSQL credentials
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=noc_alerts

# =============================================================================
# OPTIONAL — demo mode works without these; fill in when you want real integrations
# =============================================================================

# Demo mode login password (default: admin123 if left blank)
DEMO_PASSWORD=admin123

# CORS origins allowed to call the API
# For Docker + local frontend: http://localhost:3000,http://localhost:5173
# For production: https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend URL used in email links
FRONTEND_URL=http://localhost:3000

# App display name
APP_NAME=Sentrix

# =============================================================================
# DATABASE — Docker internal routing (do not change for docker compose)
# =============================================================================
DB_HOST=postgres
DB_PORT=5432
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# =============================================================================
# KAFKA — Docker internal routing (do not change for docker compose)
# =============================================================================
KAFKA_BROKER=kafka:9092

# =============================================================================
# INTERNAL SERVICE URLS — Docker network (do not change for docker compose)
# =============================================================================
INGESTOR_CORE_URL=http://ingestor-core:8001
EVENT_ROUTER_URL=http://event-router:8082
API_GATEWAY_URL=http://api-gateway:8080

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_RATE=500
RATE_LIMIT_BURST=50

# =============================================================================
# PGADMIN (Database GUI at http://localhost:5050)
# =============================================================================
PGADMIN_EMAIL=admin@sentrix.local
PGADMIN_PASSWORD=admin

# =============================================================================
# SMTP EMAIL — Optional. Leave blank to skip email features.
# Gmail example: create an App Password at myaccount.google.com/apppasswords
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Sentrix

# =============================================================================
# GOOGLE OAUTH — Optional. Leave blank to disable Google login.
# Create credentials at console.cloud.google.com → APIs & Services → Credentials
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# =============================================================================
# IBM WATSON AI — Optional. Leave blank; platform runs in demo mode without it.
# Get keys at cloud.ibm.com → watsonx → Projects → your project → Manage
# =============================================================================
WATSONX_API_KEYS=
WATSONX_REGION=eu-gb
WATSONX_PROJECT_ID=
FORWARD_TO_GATEWAY=false
